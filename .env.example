# docker-compose.yml 의 ${VAR} 치환에 쓰이는 값들입니다.
# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요.
#
#   cp .env.example .env
#
# 주의: backend/.env 는 컨테이너 "안"으로 주입되는 파일이고,
# 이 루트 .env 는 compose 가 ${VAR} 를 "치환"할 때 읽는 파일입니다.
# 둘은 별개이며, 빌드 인자(args)와 db 설정은 반드시 이 루트 .env 가 있어야 채워집니다.

# ---- PostgreSQL ----
# 이 값들로 DB 컨테이너가 만들어지고, backend 의 DATABASE_URL 도 같은 값으로 조립됩니다.
# POSTGRES_PASSWORD 가 비어 있으면 compose 가 실행을 거부합니다.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=travel_db

# ---- 프론트엔드 빌드 타임 주입 ----
# NEXT_PUBLIC_* 값은 빌드 시점에 JS 번들에 박히므로,
# 바꾸면 재시작이 아니라 재빌드(--build)가 필요합니다.
# 브라우저에 그대로 노출되는 값이니 비밀키를 넣지 마세요.
NEXT_PUBLIC_API_URL=https://api.travelmap.win
NEXT_PUBLIC_KAKAO_APP_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_KAKAO_REST_API_KEY=
